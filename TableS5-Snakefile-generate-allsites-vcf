rule make_bamlist:
    input:
        BAMS
    output:
        f"{OUTPUT_DIR}/metadata/bamlist.txt"
    run:
        Path(os.path.dirname(output[0])).mkdir(parents=True, exist_ok=True)
        with open(output[0], "w") as handle:
            for bam in input:
                handle.write(f"{bam}\n")


rule call_allsites_per_chrom:
    input:
        bamlist=f"{OUTPUT_DIR}/metadata/bamlist.txt"
    output:
        vcf=f"{OUTPUT_DIR}/vcf/raw/{{chrom}}.allsites.vcf.gz",
        tbi=f"{OUTPUT_DIR}/vcf/raw/{{chrom}}.allsites.vcf.gz.tbi"
    params:
        region=lambda wildcards: wildcards.chrom
    threads: 8
    shell:
        r"""
        mkdir -p {OUTPUT_DIR}/vcf/raw
        bcftools mpileup \
            -Ou \
            -f {REFERENCE} \
            -b {input.bamlist} \
            -r {params.region} \
            --max-depth 1000 \
        | bcftools call \
            --threads {threads} \
            -m \
            -Oz \
            -f GQ \
            -o {output.vcf}
        tabix -f -p vcf {output.vcf}
        """


rule basic_filter_per_chrom:
    input:
        vcf=f"{OUTPUT_DIR}/vcf/raw/{{chrom}}.allsites.vcf.gz",
        tbi=f"{OUTPUT_DIR}/vcf/raw/{{chrom}}.allsites.vcf.gz.tbi"
    output:
        vcf=f"{OUTPUT_DIR}/vcf/basic/{{missing_tag}}/{{chrom}}.basic.allsites.vcf.gz",
        tbi=f"{OUTPUT_DIR}/vcf/basic/{{missing_tag}}/{{chrom}}.basic.allsites.vcf.gz.tbi"
    params:
        max_missing=lambda wildcards: MISSING_FILTER_BRANCHES[wildcards.missing_tag],
        minDP=BASIC_FILTERS["minDP"],
        maxDP=BASIC_FILTERS["maxDP"]
    shell:
        r"""
        mkdir -p {OUTPUT_DIR}/vcf/basic/{wildcards.missing_tag}
        vcftools \
            --gzvcf {input.vcf} \
            --max-missing {params.max_missing} \
            --minDP {params.minDP} \
            --maxDP {params.maxDP} \
            --recode \
            --recode-INFO-all \
            --stdout \
        | bgzip -c > {output.vcf}
        tabix -f -p vcf {output.vcf}
        """


rule split_invariant_per_chrom:
    input:
        vcf=f"{OUTPUT_DIR}/vcf/basic/{{missing_tag}}/{{chrom}}.basic.allsites.vcf.gz",
        tbi=f"{OUTPUT_DIR}/vcf/basic/{{missing_tag}}/{{chrom}}.basic.allsites.vcf.gz.tbi"
    output:
        vcf=f"{OUTPUT_DIR}/vcf/split/{{missing_tag}}/{{chrom}}.invariant.vcf.gz",
        tbi=f"{OUTPUT_DIR}/vcf/split/{{missing_tag}}/{{chrom}}.invariant.vcf.gz.tbi"
    threads: 8
    shell:
        r"""
        mkdir -p {OUTPUT_DIR}/vcf/split/{wildcards.missing_tag}
        bcftools view \
            --threads {threads} \
            -i 'N_ALT=0' \
            -Oz \
            -o {output.vcf} \
            {input.vcf}
        tabix -f -p vcf {output.vcf}
        """


