        tbis=lambda wildcards: expand(
            f"{OUTPUT_DIR}/vcf/rebuilt/{wildcards.missing_tag}" + "/{chrom}.pixy-ready.vcf.gz.tbi",
            chrom=CHROMS,
        )
    output:
        vcf=f"{OUTPUT_DIR}/vcf/{{missing_tag}}/pixy.filtered.allsites.vcf.gz",
        tbi=f"{OUTPUT_DIR}/vcf/{{missing_tag}}/pixy.filtered.allsites.vcf.gz.tbi"
    threads: 8
    shell:
        r"""
        mkdir -p {OUTPUT_DIR}/vcf/{wildcards.missing_tag}
        bcftools concat \
            --threads {threads} \
            -Oz \
            -o {output.vcf} \
            {input.vcfs}
        tabix -f -p vcf {output.vcf}
        """


rule run_pixy:
    input:
        vcf=f"{OUTPUT_DIR}/vcf/{{missing_tag}}/pixy.filtered.allsites.vcf.gz",
        tbi=f"{OUTPUT_DIR}/vcf/{{missing_tag}}/pixy.filtered.allsites.vcf.gz.tbi",
        populations=lambda wildcards: POPULATION_FILES[wildcards.panel]
    output:
        f"{OUTPUT_DIR}/pixy/{{missing_tag}}/{{panel}}/pixy_pi.txt"
    params:
        window_size=100000,
        output_prefix="pixy"
    threads: 8
    shell:
        r"""
        mkdir -p {OUTPUT_DIR}/pixy/{wildcards.missing_tag}/{wildcards.panel}
        {PIXY_PYTHON} -m pixy \
            --stats pi \
            --vcf {input.vcf} \
            --populations {input.populations} \
            --window_size {params.window_size} \
            --n_cores {threads} \
            --output_folder {OUTPUT_DIR}/pixy/{wildcards.missing_tag}/{wildcards.panel} \
            --output_prefix {params.output_prefix}
        """
