rule concat_branches_per_chrom:
    input:
        invariant_vcf=f"{OUTPUT_DIR}/vcf/filtered/{{missing_tag}}/{{chrom}}.invariant.filtered.vcf.gz",
        invariant_tbi=f"{OUTPUT_DIR}/vcf/filtered/{{missing_tag}}/{{chrom}}.invariant.filtered.vcf.gz.tbi",
        variant_vcf=f"{OUTPUT_DIR}/vcf/filtered/{{missing_tag}}/{{chrom}}.variant.filtered.vcf.gz",
        variant_tbi=f"{OUTPUT_DIR}/vcf/filtered/{{missing_tag}}/{{chrom}}.variant.filtered.vcf.gz.tbi"
    output:
        vcf=f"{OUTPUT_DIR}/vcf/rebuilt/{{missing_tag}}/{{chrom}}.pixy-ready.vcf.gz",
        tbi=f"{OUTPUT_DIR}/vcf/rebuilt/{{missing_tag}}/{{chrom}}.pixy-ready.vcf.gz.tbi"
    threads: 8
    shell:
        r"""
        mkdir -p {OUTPUT_DIR}/vcf/rebuilt/{wildcards.missing_tag}
        bcftools concat \
            --threads {threads} \
            -a \
            -Oz \
            -o {output.vcf}.tmp.concat.vcf.gz \
            {input.invariant_vcf} \
            {input.variant_vcf}
        bcftools sort \
            --threads {threads} \
            -Oz \
            -o {output.vcf} \
            {output.vcf}.tmp.concat.vcf.gz
        tabix -f -p vcf {output.vcf}
        rm -f {output.vcf}.tmp.concat.vcf.gz
        """


rule merge_pixy_ready_vcf:
    input:
        vcfs=lambda wildcards: expand(
            f"{OUTPUT_DIR}/vcf/rebuilt/{wildcards.missing_tag}" + "/{chrom}.pixy-ready.vcf.gz",
            chrom=CHROMS,
