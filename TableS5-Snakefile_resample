            --sample-n "{params.sample_n}" \
            --replicates "1" \
            --seed "{params.base_seed}" \
            --window-size "{params.window_size}" \
            --window-step "{params.window_step}" \
            --output-dir "{params.output_dir}" \
            --summary-out "{output.summary}" \
            --metrics-out "{output.metrics}" \
            --manifest-out "{output.manifest}" \
            --sampling-mode "{params.sampling_mode}" \
            --unique-only
        """


rule rollup_panel_summary:
    input:
        lambda wildcards: panel_summary_inputs(
            wildcards.panel, int(wildcards.reps)
        )
    output:
        f"{OUTPUT_DIR}/{{panel}}/n{{sample_n}}/rep{{reps}}/panel_summary.tsv"
    run:
        Path(os.path.dirname(output[0])).mkdir(parents=True, exist_ok=True)
        header_written = False
        with open(output[0], "w") as out_handle:
            for summary_file in input:
                with open(summary_file) as in_handle:
                    lines = in_handle.readlines()
                if not lines:
                    continue
                if not header_written:
                    out_handle.write(lines[0])
                    header_written = True
                for line in lines[1:]:
                    out_handle.write(line)


