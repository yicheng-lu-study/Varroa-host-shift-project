from pathlib import Path
import glob
import hashlib
import math
import os
import subprocess


localrules: all, write_feasibility_report, panelA, panelB, panelC


VCF_PATH = config.get("vcf_path", "vcf/snps_0095.recode.vcf")
OUTPUT_DIR = config.get("output_dir", "output")
SAMPLING_MODE = config.get("sampling_mode", "random")
if SAMPLING_MODE not in {"random", "balanced"}:
    raise ValueError("sampling_mode must be either 'random' or 'balanced'")

PANELS = {
    "panelA": {
        "pop_dir": "input-group/panelA",
        "sample_n": 4,   
        "seed": 1101,
    },
    "panelB": {
        "pop_dir": "input-group/panelB",
        "sample_n": 5,   
        "seed": 2202,
    },
    "panelC": {
        "pop_dir": "input-group/panelC",
        "sample_n": 7,   
        "seed": 3303,
    },
}

REPLICATE_TARGETS = [100, 200]
WINDOW_SIZE = 100000
WINDOW_STEP = 10000
UNIQUE_ONLY = True


def is_placeholder(path: str) -> bool:
    return path.startswith("__") and path.endswith("__")


def sample_count(pop_file: str) -> int:
    with open(pop_file) as handle:
        return sum(1 for line in handle if line.strip())


def stable_seed(panel: str, group: str, replicates: int) -> int:
    payload = f"{panel}|{group}|{replicates}".encode("utf-8")
    digest = hashlib.sha256(payload).hexdigest()
    return int(digest[:8], 16)


def feasible_replicates(n_samples: int, sample_n: int):
    if sample_n > n_samples:
        return []
    total = math.comb(n_samples, sample_n)
    return [rep for rep in REPLICATE_TARGETS if total >= rep]


def group_summary_path(panel: str, group: str, rep: int) -> str:
    n = PANELS[panel]["sample_n"]
    return f"{OUTPUT_DIR}/{panel}/n{n}/rep{rep}/{group}/summary.tsv"


def group_metrics_path(panel: str, group: str, rep: int) -> str:
    n = PANELS[panel]["sample_n"]
    return f"{OUTPUT_DIR}/{panel}/n{n}/rep{rep}/{group}/replicate_metrics.tsv"


def pop_manifest_path(panel: str, group: str, rep: int) -> str:
    n = PANELS[panel]["sample_n"]
    return f"{OUTPUT_DIR}/{panel}/n{n}/rep{rep}/{group}/replicate_pop_manifest.tsv"


def all_samples_summary_path(panel: str, group: str) -> str:
    return f"{OUTPUT_DIR}/{panel}/all_samples/{group}/summary.tsv"


def all_samples_metrics_path(panel: str, group: str) -> str:
    return f"{OUTPUT_DIR}/{panel}/all_samples/{group}/replicate_metrics.tsv"


def all_samples_manifest_path(panel: str, group: str) -> str:
    return f"{OUTPUT_DIR}/{panel}/all_samples/{group}/replicate_pop_manifest.tsv"


PANEL_GROUPS = {}
FEASIBILITY_ROWS = []

for panel, panel_cfg in PANELS.items():
    pop_dir = panel_cfg["pop_dir"]
    groups = []
    if not is_placeholder(pop_dir) and os.path.isdir(pop_dir):
        for pop_file in sorted(glob.glob(os.path.join(pop_dir, "*.pop"))):
            group = Path(pop_file).stem
            n_samples = sample_count(pop_file)
            reps = feasible_replicates(n_samples, panel_cfg["sample_n"])
            groups.append(
                {
                    "group": group,
                    "pop_file": pop_file,
                    "n_samples": n_samples,
                    "replicates": reps,
                }
            )
            FEASIBILITY_ROWS.append(
                {
                    "panel": panel,
                    "group": group,
                    "pop_file": pop_file,
                    "n_samples": n_samples,
                    "sample_n": panel_cfg["sample_n"],
                    "combination_count": math.comb(n_samples, panel_cfg["sample_n"])
                    if panel_cfg["sample_n"] <= n_samples
                    else 0,
                    "run_rep100": 100 in reps,
                    "run_rep200": 200 in reps,
                    "status": "included" if reps else "excluded",
                }
            )
    PANEL_GROUPS[panel] = groups


def panel_target_summaries(panel: str):
    outputs = []
    for item in PANEL_GROUPS[panel]:
        for rep in item["replicates"]:
            outputs.append(group_summary_path(panel, item["group"], rep))
            outputs.append(group_metrics_path(panel, item["group"], rep))
            outputs.append(pop_manifest_path(panel, item["group"], rep))
    return outputs


def panel_rollup_path(panel: str, rep: int) -> str:
    n = PANELS[panel]["sample_n"]
    return f"{OUTPUT_DIR}/{panel}/n{n}/rep{rep}/panel_summary.tsv"


def panel_rollup_targets(panel: str):
    reps = set()
    for item in PANEL_GROUPS[panel]:
        reps.update(item["replicates"])
    return [panel_rollup_path(panel, rep) for rep in sorted(reps)]


def panel_summary_inputs(panel: str, rep: int):
    files = []
    for item in PANEL_GROUPS[panel]:
        if rep in item["replicates"]:
            files.append(group_summary_path(panel, item["group"], rep))
    return files


def master_rollup_targets():
    files = []
    for panel in PANELS:
        files.extend(panel_rollup_targets(panel))
    return files


def get_pop_file(panel: str, group: str) -> str:
    for item in PANEL_GROUPS[panel]:
        if item["group"] == group:
            return item["pop_file"]
    raise ValueError(f"Unknown group {group} in {panel}")


def get_n_samples(panel: str, group: str) -> int:
    for item in PANEL_GROUPS[panel]:
        if item["group"] == group:
            return item["n_samples"]
    raise ValueError(f"Unknown group {group} in {panel}")


def all_samples_group_targets():
    outputs = []
    for panel in PANELS:
        for item in PANEL_GROUPS[panel]:
            outputs.append(all_samples_summary_path(panel, item["group"]))
            outputs.append(all_samples_metrics_path(panel, item["group"]))
            outputs.append(all_samples_manifest_path(panel, item["group"]))
    return outputs


def panel_all_samples_summary_path(panel: str) -> str:
    return f"{OUTPUT_DIR}/{panel}/all_samples/panel_all_samples_summary.tsv"


def panel_all_samples_summary_inputs(panel: str):
    return [
        all_samples_summary_path(panel, item["group"])
        for item in PANEL_GROUPS[panel]
    ]


def panel_all_samples_summary_targets():
    return [
        panel_all_samples_summary_path(panel)
        for panel in PANELS
        if PANEL_GROUPS[panel]
    ]


def master_all_samples_summary_path() -> str:
    return f"{OUTPUT_DIR}/feasibility/master_all_samples_summary.tsv"


def panel_rep_metrics_inputs(panel: str, rep: int):
    files = []
    for item in PANEL_GROUPS[panel]:
        if rep in item["replicates"]:
            files.append(group_metrics_path(panel, item["group"], rep))
    return files


def panel_rep_values(panel: str):
    reps = set()
    for item in PANEL_GROUPS[panel]:
        reps.update(item["replicates"])
    return sorted(reps)


def panel_rep_scatter_path(panel: str, rep: int) -> str:
    n = PANELS[panel]["sample_n"]
    return (
        f"{OUTPUT_DIR}/plots/{panel}/n{n}/rep{rep}/"
        f"{panel}_n{n}_rep{rep}_replicate_scatter.pdf"
    )


def panel_summary_plot_path(panel: str) -> str:
    return f"{OUTPUT_DIR}/plots/{panel}/{panel}_summary_by_replicate_count.pdf"


def all_panels_summary_plot_path() -> str:
    return f"{OUTPUT_DIR}/plots/all_panels_summary_by_replicate_count.pdf"


def all_samples_summary_plot_path() -> str:
    return f"{OUTPUT_DIR}/plots/all_panels_all_samples_summary.pdf"


def combined_summary_plot_path() -> str:
    return f"{OUTPUT_DIR}/plots/all_panels_rarefaction_and_all_samples_summary.pdf"


def panel_rep_scatter_targets():
    files = []
    for panel in PANELS:
        for rep in panel_rep_values(panel):
            files.append(panel_rep_scatter_path(panel, rep))
    return files


def panel_summary_plot_targets():
    files = []
    for panel in PANELS:
        if panel_rep_values(panel):
            files.append(panel_summary_plot_path(panel))
    return files


def plot_targets():
    return (
        panel_rep_scatter_targets()
        + panel_summary_plot_targets()
        + [all_panels_summary_plot_path()]
        + [all_samples_summary_plot_path()]
        + [combined_summary_plot_path()]
    )


rule all:
    input:
        f"{OUTPUT_DIR}/feasibility/rarefaction_feasibility.tsv",
        f"{OUTPUT_DIR}/feasibility/master_panel_summary.tsv",
