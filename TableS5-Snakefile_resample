rule plot_panel_rep_scatter:
    input:
        metrics=lambda wildcards: panel_rep_metrics_inputs(
            wildcards.panel, int(wildcards.reps)
        ),
        script="scripts/plot_panel_rarefaction.R"
    output:
        f"{OUTPUT_DIR}/plots/{{panel}}/n{{sample_n}}/rep{{reps}}/"
        f"{{panel}}_n{{sample_n}}_rep{{reps}}_replicate_scatter.pdf"
    run:
        Path(os.path.dirname(output[0])).mkdir(parents=True, exist_ok=True)
        input_list = str(output[0]) + ".inputs.txt"
        with open(input_list, "w") as handle:
            for path in input.metrics:
                handle.write(str(path) + "\n")
        try:
            subprocess.run(
                [
                    "Rscript",
                    input.script,
                    "--mode",
                    "scatter",
                    "--metrics-list",
                    input_list,
                    "--output",
                    output[0],
                    "--panel",
                    wildcards.panel,
                    "--sample-n",
                    wildcards.sample_n,
                    "--replicates",
                    wildcards.reps,
                ],
                check=True,
            )
        finally:
            if os.path.exists(input_list):
                os.remove(input_list)


