rule run_group_rarefaction:
    input:
        pop_file=lambda wildcards: get_pop_file(wildcards.panel, wildcards.group)
    output:
        summary=f"{OUTPUT_DIR}/{{panel}}/n{{sample_n}}/rep{{reps}}/{{group}}/summary.tsv",
        metrics=f"{OUTPUT_DIR}/{{panel}}/n{{sample_n}}/rep{{reps}}/{{group}}/replicate_metrics.tsv",
        manifest=f"{OUTPUT_DIR}/{{panel}}/n{{sample_n}}/rep{{reps}}/{{group}}/replicate_pop_manifest.tsv"
    params:
        vcf=VCF_PATH,
        output_dir=lambda wildcards: f"{OUTPUT_DIR}/{wildcards.panel}/n{wildcards.sample_n}/rep{wildcards.reps}/{wildcards.group}",
        sample_n=lambda wildcards: int(wildcards.sample_n),
        base_seed=lambda wildcards: PANELS[wildcards.panel]["seed"]
        + stable_seed(wildcards.panel, wildcards.group, int(wildcards.reps)),
        unique_flag="--unique-only" if UNIQUE_ONLY else "",
        sampling_mode=SAMPLING_MODE,
        window_size=WINDOW_SIZE,
        window_step=WINDOW_STEP
    shell:
        r"""
        python3 scripts/run_rarefaction_vcftools.py \
            --vcf "{params.vcf}" \
            --source-pop "{input.pop_file}" \
            --panel "{wildcards.panel}" \
            --group "{wildcards.group}" \
            --sample-n "{params.sample_n}" \
            --replicates "{wildcards.reps}" \
            --seed "{params.base_seed}" \
            --window-size "{params.window_size}" \
            --window-step "{params.window_step}" \
            --output-dir "{params.output_dir}" \
            --summary-out "{output.summary}" \
            --metrics-out "{output.metrics}" \
            --manifest-out "{output.manifest}" \
            --sampling-mode "{params.sampling_mode}" \
            {params.unique_flag}
        """


