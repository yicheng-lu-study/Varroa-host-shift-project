        f"{OUTPUT_DIR}/feasibility/panelB.done",
        f"{OUTPUT_DIR}/feasibility/panelC.done",
        all_samples_group_targets(),
        panel_all_samples_summary_targets(),
        master_all_samples_summary_path(),
        plot_targets(),


rule write_feasibility_report:
    output:
        f"{OUTPUT_DIR}/feasibility/rarefaction_feasibility.tsv"
    run:
        Path(os.path.dirname(output[0])).mkdir(parents=True, exist_ok=True)
        with open(output[0], "w") as handle:
            handle.write(
                "\t".join(
                    [
                        "panel",
                        "group",
                        "pop_file",
                        "n_samples",
                        "sample_n",
                        "combination_count",
                        "run_rep100",
                        "run_rep200",
                        "status",
                    ]
                )
                + "\n"
            )
            for row in FEASIBILITY_ROWS:
                handle.write(
                    "\t".join(
                        [
                            row["panel"],
                            row["group"],
                            row["pop_file"],
                            str(row["n_samples"]),
                            str(row["sample_n"]),
                            str(row["combination_count"]),
                            str(row["run_rep100"]),
                            str(row["run_rep200"]),
                            row["status"],
                        ]
                    )
                    + "\n"
                )


